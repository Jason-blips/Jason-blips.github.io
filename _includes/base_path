{% if site.url %}
  {% if site.url contains "://" %}
    {% comment %}Use relative path to avoid CORS and Mixed Content issues{% endcomment %}
    {% assign base_path = site.baseurl %}
  {% else %}
    {% assign base_path = site.url | append: site.baseurl %}
  {% endif %}
{% else %}
  {% if site.github.url %}
    {% assign base_path = site.baseurl %}
  {% else %}
    {% assign base_path = site.baseurl %}
  {% endif %}
{% endif %}